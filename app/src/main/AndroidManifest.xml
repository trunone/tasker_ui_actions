<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.Light.DarkActionBar"
        android:supportsRtl="true"
        tools:targetApi="31">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PluginActivity"
            android:exported="true"
            android:label="@string/plugin_name"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
            </intent-filter>
        </activity>

        <activity
            android:name=".StateActivity"
            android:exported="true"
            android:label="@string/state_plugin_name"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_CONDITION" />
            </intent-filter>
            <meta-data
                android:name="net.dinglisch.android.tasker.subcategories"
                android:value="net.dinglisch.android.tasker.subcategories.STATE" />
        </activity>

        <activity
            android:name=".EventActivity"
            android:exported="true"
            android:label="@string/event_plugin_name"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_CONDITION" />
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_EVENT" />
                <action android:name="net.dinglisch.android.tasker.ACTION_EDIT_EVENT" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="com.twofortyfouram.locale.intent.category.EVENT" />
                <category android:name="net.dinglisch.android.tasker.subcategories.EVENT" />
            </intent-filter>
            <meta-data
                android:name="net.dinglisch.android.tasker.subcategories"
                android:value="net.dinglisch.android.tasker.subcategories.EVENT" />
            <meta-data
                android:name="net.dinglisch.android.tasker.is_event"
                android:value="true" />
            <meta-data
                android:name="com.twofortyfouram.locale.intent.extra.IS_EVENT"
                android:value="true" />
            <meta-data
                android:name="net.dinglisch.android.tasker.extras.IS_EVENT"
                android:value="true" />
            <meta-data
                android:name="is_event"
                android:value="true" />
        </activity>

        <receiver
            android:name=".CaptureReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.example.taskerplugin.ACTION_CAPTURE_VIEW_IDS" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".PluginReceiver"
            android:exported="true"
            android:label="@string/plugin_name"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".StateReceiver"
            android:exported="true"
            android:label="@string/state_plugin_name"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.QUERY_CONDITION" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".EventReceiver"
            android:exported="true"
            android:label="@string/event_plugin_name"
            android:icon="@mipmap/ic_launcher">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.QUERY_CONDITION" />
                <action android:name="com.twofortyfouram.locale.intent.action.QUERY_EVENT" />
            </intent-filter>
            <meta-data
                android:name="net.dinglisch.android.tasker.subcategories"
                android:value="net.dinglisch.android.tasker.subcategories.EVENT" />
            <meta-data
                android:name="net.dinglisch.android.tasker.is_event"
                android:value="true" />
        </receiver>

        <service
            android:name=".ClickService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name"
            android:exported="true"
            android:description="@string/accessibility_service_description">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

    </application>

</manifest>
